# Isi di Vercel → Settings → Environment Variables. JANGAN commit token asli.
BOT_TOKEN=
# Opsional: kunci dashboard
ACCESS_KEY=
# Opsional: upload drag-and-drop (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=
# Opsional: jadwal kirim (Upstash Redis, gratis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opsional: kunci untuk endpoint /api/cron
CRON_SECRET=
